---
// Tab-switcher procedure section — faithful to the Claude Code draft design
// (narrow centred column, segmented tabs, visual-on-top panel, full-width CTA),
// wired to content.ts, on-brand tokens, and a working modal CTA.
import { content } from '../data/content';
const { procedures: proc } = content;

// Inline stroke icons for the per-procedure info rows.
// Order matches each item's `info[]`: operation time, return to work, hospital stay, anaesthesia.
const infoIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1.5"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5c3.5 4 5.5 6.6 5.5 9.2a5.5 5.5 0 0 1-11 0C6.5 10.1 8.5 7.5 12 3.5z"/></svg>',
];
---

<section class="procedures section" id="procedures">
  <div class="container">
    <div class="proc-head">
      <span class="proc-eyebrow">{proc.eyebrow}</span>
      <h2 class="proc-title">{proc.sectionTitle}</h2>
      <p class="proc-intro">{proc.sectionSubtitle}</p>

      {/* Tab / segmented control */}
      <div class="proc-tabs" role="tablist" aria-label={proc.sectionTitle}>
        {proc.items.map((p, i) => (
          <button
            type="button"
            class:list={["proc-tab", { active: i === 0 }]}
            id={`proc-tab-${i}`}
            data-tab={i}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`proc-panel-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >{p.tab}</button>
        ))}
      </div>
    </div>

    {/* Panels */}
    {proc.items.map((p, i) => (
      <article
        class:list={["proc-panel", { active: i === 0 }]}
        id={`proc-panel-${i}`}
        data-panel={i}
        role="tabpanel"
        aria-labelledby={`proc-tab-${i}`}
      >
        <div class="proc-visual">
          <picture>
            {(p as { imageMobile?: string }).imageMobile && (
              <source media="(max-width: 767px)" srcset={(p as { imageMobile?: string }).imageMobile} />
            )}
            <img src={p.image} alt={p.alt} width="900" height="1125" loading="lazy" decoding="async" />
          </picture>
        </div>

        <div class="proc-body">
          <h3 class="proc-name">{p.title}</h3>
          <span class="proc-sub">{p.subtitle}</span>
          <p class="proc-desc">{p.description}</p>

          <dl class="proc-specs">
            {p.info.map((info, idx) => (
              <div class="proc-spec">
                <span class="proc-spec-icon" aria-hidden="true" set:html={infoIcons[idx]} />
                <div class="proc-spec-text">
                  <dt>{info.label}</dt>
                  <dd>{info.value}</dd>
                </div>
              </div>
            ))}
          </dl>

          <ul class="proc-points">
            {p.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
      </article>
    ))}

    <div class="proc-cta-wrap">
      <a href="#consultation" class="btn btn-primary btn-lg" data-open-form-modal>{proc.ctaButton}</a>
    </div>
  </div>
</section>

<style>
  .procedures {
    background: var(--cream);
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  /* ---- Head (centred): eyebrow + title + intro + tabs ---- */
  .proc-head {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .proc-eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--champagne-dark);
    margin-bottom: 10px;
  }

  .proc-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .proc-intro {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 auto 20px;
  }

  /* ---- Tabs / segmented control ---- */
  .proc-tabs {
    display: flex;
    gap: 6px;
    padding: 5px;
    background: var(--cream-2);
    border-radius: var(--radius-md);
    max-width: 380px;
    margin: 0 auto;
  }

  .proc-tab {
    flex: 1;
    padding: 11px 8px;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    transition: background var(--transition-base), color var(--transition-base);
  }

  .proc-tab.active {
    background: var(--ink);
    color: var(--cream);
    box-shadow: var(--shadow-sm);
  }

  .proc-tab:focus-visible {
    outline: 2px solid var(--champagne);
    outline-offset: 2px;
  }

  /* ---- Panel ---- */
  .proc-panel {
    display: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    max-width: 920px;
    margin: 0 auto;
  }

  .proc-panel.active {
    display: block;
  }

  .proc-visual {
    position: relative;
    overflow: hidden;
    background: var(--sand);
    aspect-ratio: 4 / 3;
  }

  .proc-visual picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .proc-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fox Eye portrait (first card): on mobile the 4/3 crop cuts off the lower
     subject, so shift the crop down to preserve the intended composition. */
  @media (max-width: 767px) {
    .proc-panel[data-panel="0"] .proc-visual img {
      object-position: center 72%;
    }
  }

  .proc-body {
    padding: 22px 20px;
  }

  .proc-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 6px;
  }

  .proc-sub {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--champagne-dark);
    margin-bottom: 14px;
  }

  .proc-desc {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 20px;
  }

  /* ---- Specs with icons (single column on mobile) ---- */
  .proc-specs {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .proc-spec {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .proc-spec-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream);
    border: 1px solid var(--sand);
    border-radius: var(--radius-md);
    color: var(--champagne-dark);
  }

  .proc-spec-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .proc-spec-text {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 10px;
  }

  .proc-spec dt {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .proc-spec dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  /* ---- Bullet points ---- */
  .proc-points {
    list-style: none;
    margin: 18px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .proc-points li {
    position: relative;
    padding-left: 19px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
  }

  .proc-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 8px;
    height: 8px;
    border: 1px solid var(--champagne);
    border-radius: 50%;
  }

  .proc-cta-wrap {
    text-align: center;
    margin-top: var(--space-xl);
  }

  /* =========================================================
     TABLET — ≥ 768px : two-column panel, specs as 2-col grid
     ========================================================= */
  @media (min-width: 768px) {
    .proc-head { margin-bottom: var(--space-2xl); }
    .proc-title { font-size: 34px; }

    .proc-panel {
      display: none;
      grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
    }
    .proc-panel.active { display: grid; }

    .proc-visual { aspect-ratio: auto; min-height: 340px; }

    .proc-body { padding: 30px 30px 28px; }
    .proc-name { font-size: 24px; }
    .proc-desc { font-size: 15px; margin-bottom: 22px; }

    /* specs become a 2-up grid of bordered cells */
    .proc-specs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .proc-spec {
      padding: 13px 14px;
      border-top: none;
      background: var(--cream);
      border: 1px solid var(--sand);
      border-radius: var(--radius-md);
    }
    .proc-spec-icon {
      background: var(--white);
      width: 32px;
      height: 32px;
    }
    .proc-spec-text {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2px;
    }
  }

  /* =========================================================
     DESKTOP — ≥ 1024px : wider panel, larger type, 2-col points
     ========================================================= */
  @media (min-width: 1024px) {
    .proc-panel { grid-template-columns: minmax(0, 42%) minmax(0, 1fr); }
    .proc-visual { min-height: 420px; }
    .proc-body { padding: 44px 44px 40px; }
    .proc-name { font-size: 28px; line-height: 1.18; }
    .proc-desc { font-size: 15px; line-height: 1.75; margin-bottom: 26px; }
    .proc-spec-icon { width: 36px; height: 36px; }
    .proc-spec dd { font-size: 15px; }

    .proc-points {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 22px;
    }
  }
</style>

<script>
  // Tab switching — scoped to the procedures section. Vanilla JS, no island needed.
  const section = document.getElementById('procedures');
  if (section) {
    const tabs = Array.from(section.querySelectorAll<HTMLElement>('.proc-tab'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('.proc-panel'));

    const activate = (i: number) => {
      tabs.forEach((t, idx) => {
        const on = idx === i;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.setAttribute('tabindex', on ? '0' : '-1');
      });
      panels.forEach((p) => {
        p.classList.toggle('active', p.getAttribute('data-panel') === String(i));
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        let next: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          activate(next);
          tabs[next].focus();
        }
      });
    });
  }
</script>
