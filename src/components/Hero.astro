---
// Hero — two approved designs, one per breakpoint, switching at 1024px (the
// same breakpoint the header uses):
//
//   >= 1024px ("9A"): one sand slab, content left / portrait right, no shadow,
//                     no border, 16px radius on all four corners.
//   <  1024px ("6A"): full-bleed photo band, then a sand card pulled up over it
//                     by 40px holding the headline, checklist and CTA.
//
// The two layouts share ONE <picture>, repositioned with flex order + CSS. Two
// separate <img> elements toggled with display:none would download both files
// in most browsers, which would wreck the LCP on the breakpoint that loses.
import { content } from '../data/content';
import { asset } from '../data/asset';
const { hero } = content;
---

<section class="hero" id="hero">
  <div class="hero-shell">
    <div class="hero-slab">
      <div class="hero-media">
        <picture>
          <source
            media="(min-width: 1024px)"
            type="image/webp"
            srcset={`${asset('/images/celal-hero-slab-1600.webp')} 1600w, ${asset('/images/celal-hero-slab-2000.webp')} 2000w`}
            sizes="(min-width: 1180px) 580px, 50vw"
          />
          {/* Mobile band is the default candidate, so phones never see the
              2000px slab crop. */}
          <img
            src={asset('/images/celal-hero-band-600.webp')}
            alt={hero.imageAlt}
            width="600"
            height="645"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>

      <div class="hero-card">
        <p class="hero-eyebrow">{hero.eyebrow}</p>

        {/* One h1 in the DOM; the inactive line is display:none, so it is out
            of the accessibility tree rather than read twice. */}
        <h1 class="hero-headline">
          <span class="hl-desktop">{hero.headlineDesktop}</span>
          <span class="hl-mobile">{hero.headlineMobile}</span>
          <span class="hl-accent">{hero.headlineAccent}</span>
        </h1>

        <ul class="hero-features hero-features-desktop">
          {hero.featuresDesktop.map(feat => (
            <li><span class="hero-check" aria-hidden="true"></span>{feat}</li>
          ))}
        </ul>

        <ul class="hero-features hero-features-mobile">
          {hero.featuresMobile.map(feat => (
            <li><span class="hero-check" aria-hidden="true"></span>{feat}</li>
          ))}
        </ul>

        <div class="hero-cta">
          <a href="#consultation" class="btn btn-primary hero-pill" data-open-form-modal>
            {hero.ctaButton}
          </a>
          <p class="hero-note">{hero.ctaNote}</p>

          <p class="hero-ratings">
            <svg class="hero-ratings-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.06 6.6.86-4.83 4.55 1.2 6.53L12 17.35 6.13 20.5l1.2-6.53L2.5 9.42l6.6-.86L12 2.5z"/></svg>
            {hero.ratings.map((r, i) => (
              <>
                {i > 0 && <span class="hero-ratings-sep" aria-hidden="true">·</span>}
                <a href={r.url} target="_blank" rel="noopener" class="hero-ratings-link">
                  <span class="hero-ratings-score">{r.score}</span> {r.platform}
                </a>
              </>
            ))}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Shell ───────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--cream);
    /* Photo band starts flush under the fixed header on mobile. */
    padding-top: var(--header-height);
  }

  .hero-shell {
    width: 100%;
  }

  /* Mobile: no slab surface at all — the card below carries the sand. */
  .hero-slab {
    display: block;
  }

  /* ── Photo ───────────────────────────────────────────────────────── */
  /* Absolute-positioned picture in a relative box: a percentage height on the
     img would not resolve reliably against a stretched flex item, and this also
     overrides the global `img { height: auto }` reset. */
  .hero-media {
    position: relative;
    overflow: hidden;
    height: 300px;
    background: var(--line);
  }

  .hero-media picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the top of the head clear of the crop. */
    object-position: 56% 6%;
  }

  /* ── Card ────────────────────────────────────────────────────────── */
  .hero-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    /* 40px below, not the comp's 20px: the next section is .section-alt
       (--cream-2 #f3ede3) and the card is --sand #ece3d6 — close enough in tone
       that at 20px, with the card's shadow spreading ~50px, the two surfaces
       read as one block. 40px lets a clean band of --cream separate them. */
    margin: -40px 12px 40px;
    padding: 24px 20px;
    background: var(--sand);
    border-radius: 12px;
    /* The spec'd soft shadow, plus a tight second layer that grounds the bottom
       edge against the cream below — the wide blur alone spreads too far to read
       as an edge. Desktop sets box-shadow: none, so this is mobile/tablet only. */
    box-shadow:
      0 14px 38px rgba(38, 35, 31, 0.12),
      0 4px 10px rgba(38, 35, 31, 0.05);
  }

  /* Desktop-only eyebrow — mobile promotes this copy into the H1. */
  .hero-eyebrow {
    display: none;
  }

  .hero-headline {
    margin: 0;
    text-align: center;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .hl-desktop {
    display: none;
  }

  .hl-mobile {
    display: block;
  }

  .hl-accent {
    display: block;
    margin-top: 0.12em;
    font-weight: 500;
    color: var(--champagne-dark);
  }

  /* ── Checklist ───────────────────────────────────────────────────── */
  .hero-features {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
  }

  .hero-features-desktop {
    display: none;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink);
  }

  /* Circled check, drawn in CSS (the repo's existing idiom) so it does not
     depend on the body font carrying U+2713. */
  .hero-check {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--champagne-soft);
  }

  /* -60% rather than -50% on Y: a check reads optically centred slightly above
     the geometric middle of its bounding box. */
  .hero-check::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 7px;
    border: solid var(--champagne-dark);
    border-width: 0 1.5px 1.5px 0;
    transform: translate(-50%, -60%) rotate(45deg);
  }

  /* ── CTA ─────────────────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }

  /* Declared at both breakpoints because global.css overrides .btn padding
     below 768px, which would otherwise reshape the pill. */
  .hero-pill {
    height: 50px;
    width: 250px;
    max-width: 100%;
    padding: 0;
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 600;
  }

  .hero-pill:hover {
    background: #3a352e;
  }

  .hero-note {
    font-size: 12px;
    line-height: 1.4;
    color: var(--ink-soft);
    text-align: center;
  }

  /* Reviews row is desktop-only — mobile carries the claim in the header bar. */
  .hero-ratings {
    display: none;
  }

  /* 768–1023px keeps the 6A stack, but capped and centred. Left full-bleed, an
     820px-wide band would upscale the 600px crop 1.4x into a face-only shot and
     the card would stretch to ~800px with its centred headline adrift. */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .hero-slab {
      max-width: 520px;
      margin: 0 auto;
    }
  }

  /* ── Desktop 9A ──────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .hero {
      /* 8px above the slab, 44px below it. */
      padding: calc(var(--header-height) + 8px) 0 44px;
    }

    .hero-shell {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-lg);
    }

    .hero-slab {
      display: flex;
      align-items: stretch;
      min-height: 520px;
      background: var(--sand);
      border-radius: var(--radius-2xl);
      overflow: hidden;
    }

    /* Photo right, content left, without changing source order. */
    .hero-media {
      order: 2;
      flex: 0 0 51.2%;
      height: auto;
    }

    .hero-media img {
      /* 58% keeps the surgeon centred and pushes the dark door edge to the
         right margin; 50% Y never crops the top of the head. */
      object-position: 58% 50%;
    }

    .hero-card {
      order: 1;
      flex: 1 1 auto;
      /* A percentage flex-basis on a padded column breaks under content-box
         sizing, so the column is auto-basis with an explicit min-width. */
      min-width: 0;
      box-sizing: border-box;
      justify-content: center;
      gap: 0;
      margin: 0;
      /* 72px is the spec'd inset and holds from 1180px up, where .container is
         at its 1180px max. Below that the column loses width faster than the
         copy can give it back: at 1024px a 72px inset leaves 332px of text, the
         46px H1 spills to a fourth line and the checklist labels wrap, which
         pushes the slab to 705px and over-crops the portrait. Flexing the inset
         down to 40px keeps the H1 at three lines — the comp's own line count —
         with every type size untouched. */
      padding: 44px clamp(40px, 20.5vw - 170px, 72px);
      background: transparent;
      border-radius: 0;
      box-shadow: none;
    }

    .hero-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      line-height: 1.2;
      color: var(--champagne-dark);
    }

    .hero-headline {
      margin-top: 16px;
      text-align: left;
      font-size: 46px;
      line-height: 1.1;
      letter-spacing: -0.015em;
    }

    .hl-desktop {
      display: block;
    }

    .hl-mobile {
      display: none;
    }

    .hl-accent {
      margin-top: 10px;
      font-size: 28px;
      font-weight: 400;
      line-height: 1.2;
    }

    .hero-features {
      margin-top: 20px;
    }

    .hero-features-desktop {
      display: flex;
    }

    .hero-features-mobile {
      display: none;
    }

    .hero-features li {
      gap: 12px;
      font-size: 15.5px;
    }

    .hero-check {
      width: 22px;
      height: 22px;
    }

    .hero-check::after {
      width: 5px;
      height: 9px;
      border-width: 0 1.75px 1.75px 0;
    }

    .hero-cta {
      margin-top: 26px;
      align-items: flex-start;
    }

    .hero-pill {
      height: 56px;
      width: auto;
      padding: 0 38px;
      font-size: 16px;
    }

    .hero-note {
      padding-left: 4px;
      text-align: left;
    }

    .hero-ratings {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      align-self: stretch;
      margin-top: 18px;
      font-size: 12.5px;
      line-height: 1.4;
      color: var(--gray-500);
    }

    .hero-ratings-star {
      flex: 0 0 auto;
      width: 12px;
      height: 12px;
      color: var(--champagne-dark);
    }

    .hero-ratings-link {
      color: inherit;
      text-decoration: none;
    }

    .hero-ratings-link:hover {
      text-decoration: underline;
    }

    .hero-ratings-score {
      font-weight: 600;
      color: var(--ink);
    }

    /* No token holds this value; it is only ever this separator. */
    .hero-ratings-sep {
      color: #c3b8a6;
    }
  }
</style>
