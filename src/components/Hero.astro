---
// Hero — two approved designs, one per breakpoint, switching at 1024px (the
// same breakpoint the header uses):
//
//   >= 1024px ("9A"): one sand slab, content left / portrait right, no shadow,
//                     no border, 16px radius on all four corners, plus a white
//                     trust bar straddling the slab's bottom edge.
//   <  1024px ("6A"): full-bleed photo band, then a sand card pulled up over it
//                     by 40px holding the headline, checklist and CTA.
//
// The two layouts share ONE <picture>, repositioned with flex order + CSS. Two
// separate <img> elements toggled with display:none would download both files
// in most browsers, which would wreck the LCP on the breakpoint that loses.
import { content } from '../data/content';
import { asset } from '../data/asset';
const { hero } = content;
---

<section class="hero" id="hero">
  <div class="hero-shell">
    <div class="hero-slab">
      <div class="hero-media">
        <picture>
          <source
            media="(min-width: 1024px)"
            type="image/webp"
            srcset={`${asset('/images/celal-hero-slab-1600.webp')} 1600w, ${asset('/images/celal-hero-slab-2000.webp')} 2000w`}
            sizes="(min-width: 1180px) 580px, 50vw"
          />
          {/* Mobile band is the default candidate, so phones never see the
              2000px slab crop. */}
          <img
            src={asset('/images/celal-hero-band-600.webp')}
            alt={hero.imageAlt}
            width="600"
            height="645"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>

      <div class="hero-card">
        <p class="hero-eyebrow">{hero.eyebrow}</p>

        {/* One h1 in the DOM; the inactive line is display:none, so it is out
            of the accessibility tree rather than read twice. */}
        <h1 class="hero-headline">
          <span class="hl-desktop">{hero.headlineDesktop}</span>
          <span class="hl-mobile">{hero.headlineMobile}</span>
          <span class="hl-accent">{hero.headlineAccent}</span>
        </h1>

        <ul class="hero-features hero-features-desktop">
          {hero.featuresDesktop.map(feat => (
            <li><span class="hero-check" aria-hidden="true"></span>{feat}</li>
          ))}
        </ul>

        <ul class="hero-features hero-features-mobile">
          {hero.featuresMobile.map(feat => (
            <li><span class="hero-check" aria-hidden="true"></span>{feat}</li>
          ))}
        </ul>

        <div class="hero-cta">
          <a href="#consultation" class="btn btn-primary hero-pill" data-open-form-modal>
            {hero.ctaButton}
          </a>
        </div>
      </div>
    </div>

    {/* Trust bar — desktop only. Deliberately a SIBLING of .hero-slab, not a
        child: the slab's overflow:hidden (which clips the portrait to the 16px
        corner) would cut off anything overhanging its bottom edge. A negative
        top margin in normal flow lifts it 42px into the slab and leaves 40px
        below, and keeps the hero's own height honest — no absolute positioning
        to compensate for.

        One star per cell, not five: five solid stars beside "4.9" would round
        the score up. */}
    <div class="hero-trust">
      {hero.ratings.map(r => (
        <a
          href={r.url}
          target="_blank"
          rel="noopener"
          class="hero-trust-item"
          aria-label={`${r.platform}: ${r.score} out of 5 from ${r.count} ${hero.reviewsLabel} — opens in a new tab`}
        >
          {/* alt="" — the link's aria-label already names the platform, so the
              logo would otherwise be announced twice. */}
          <span class="hero-trust-brand">
            <img
              class:list={['hero-trust-logo', `is-${r.platform.toLowerCase()}`]}
              src={asset(r.logo)}
              alt=""
              width={r.logoW}
              height={r.logoH}
              {/* lazy, though the bar is inside the first viewport on desktop:
                  below 1024px .hero-trust is display:none, and a lazy image
                  with no layout box is never fetched — so phones skip all three
                  files instead of paying 12KB for a bar they never see. On
                  desktop the bar is in view at load, so they fetch immediately,
                  just below the LCP portrait in priority. */}
              loading="lazy"
              decoding="async"
            />
            {r.markOnly && <span class="hero-trust-platform">{r.platform}</span>}
          </span>
          <span class="hero-trust-meta">
            <svg class="hero-trust-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.06 6.6.86-4.83 4.55 1.2 6.53L12 17.35 6.13 20.5l1.2-6.53L2.5 9.42l6.6-.86L12 2.5z"/></svg>
            <span class="hero-trust-score">{r.score}</span>
            <span class="hero-trust-sep"> · </span>{r.count} {hero.reviewsLabel}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Shell ───────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--cream);
    /* Photo band starts flush under the fixed header on mobile. */
    padding-top: var(--header-height);
  }

  .hero-shell {
    width: 100%;
  }

  /* Mobile: no slab surface at all — the card below carries the sand. */
  .hero-slab {
    display: block;
  }

  /* ── Photo ───────────────────────────────────────────────────────── */
  /* Absolute-positioned picture in a relative box: a percentage height on the
     img would not resolve reliably against a stretched flex item, and this also
     overrides the global `img { height: auto }` reset. */
  .hero-media {
    position: relative;
    overflow: hidden;
    height: 300px;
    background: var(--line);
  }

  .hero-media picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the top of the head clear of the crop. */
    object-position: 56% 6%;
  }

  /* ── Card ────────────────────────────────────────────────────────── */
  .hero-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    /* 40px below, not the comp's 20px: the next section is .section-alt
       (--cream-2 #f3ede3) and the card is --sand #ece3d6 — close enough in tone
       that at 20px, with the card's shadow spreading ~50px, the two surfaces
       read as one block. 40px lets a clean band of --cream separate them.

       -52px above, not -40px: the bottom margin anchors the card's lower edge,
       so the taller type below plus this deeper bite grow the card UPWARD over
       the photo band rather than sliding the whole card up the screen. */
    margin: -52px 12px 40px;
    padding: 28px 20px;
    background: var(--sand);
    /* 16px, the same corner the desktop slab uses (--radius-2xl), so the two
       breakpoints round the same surface identically. */
    border-radius: var(--radius-2xl);
    /* Three layers, weakest first: a hairline ring that draws the actual edge,
       a tight drop that grounds the card against the cream under its lower half,
       and the spec'd wide blur for depth. The ring is an inset shadow rather
       than a border so the desktop `box-shadow: none` cancels the whole stack
       with no second override, and it adds no layout box. */
    box-shadow:
      inset 0 0 0 1px rgba(38, 35, 31, 0.07),
      0 4px 12px rgba(38, 35, 31, 0.08),
      0 18px 44px rgba(38, 35, 31, 0.17);
  }

  /* Desktop-only eyebrow — mobile promotes this copy into the H1. */
  .hero-eyebrow {
    display: none;
  }

  .hero-headline {
    margin: 0;
    text-align: center;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .hl-desktop {
    display: none;
  }

  .hl-mobile {
    display: block;
  }

  .hl-accent {
    display: block;
    margin-top: 0.12em;
    font-weight: 500;
    color: var(--champagne-dark);
  }

  /* ── Checklist ───────────────────────────────────────────────────── */
  .hero-features {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
  }

  .hero-features-desktop {
    display: none;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
  }

  /* Circled check, drawn in CSS (the repo's existing idiom) so it does not
     depend on the body font carrying U+2713. */
  .hero-check {
    position: relative;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--champagne-soft);
  }

  /* -60% rather than -50% on Y: a check reads optically centred slightly above
     the geometric middle of its bounding box. */
  .hero-check::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5px;
    height: 8px;
    border: solid var(--champagne-dark);
    border-width: 0 1.6px 1.6px 0;
    transform: translate(-50%, -60%) rotate(45deg);
  }

  /* ── CTA ─────────────────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 11px;
    align-items: center;
  }

  /* Declared at both breakpoints because global.css overrides .btn padding
     below 768px, which would otherwise reshape the pill. */
  .hero-pill {
    height: 54px;
    width: 262px;
    max-width: 100%;
    padding: 0;
    border-radius: var(--radius-full);
    font-size: 15.5px;
    font-weight: 600;
  }

  .hero-pill:hover {
    background: #3a352e;
  }

  /* Trust bar is desktop-only — mobile carries no rating claim in the hero. */
  .hero-trust {
    display: none;
  }

  /* ── Mobile/tablet: the hero owns the first screen ─────────────────── */
  /* The 6A comp puts nothing but header + photo + card on the opening screen.
     Making .hero a column flexbox with a viewport floor lets the photo absorb
     whatever the header and the card leave over, so SurgeonBio always starts
     below the fold instead of peeking in.

     svh, not vh: on iOS vh resolves to the LARGE viewport (bars collapsed), so
     vh would overshoot by the height of the expanded Safari bars. */
  @media (max-width: 1023.98px) {
    .hero {
      /* Nothing overlays the hero at tablet width — MobileCTABar is display:none
         from 768px up. The phone override below pays for the bar. */
      --cta-bar-h: 0px;
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - var(--cta-bar-h));
    }

    .hero-shell {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
    }

    .hero-slab {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      /* The tablet block's `margin: 0 auto` is an auto cross-axis margin, which
         switches off align-items: stretch. Without an explicit width the slab
         would shrink to its content instead of the capped 520px. */
      width: 100%;
    }

    /* Grows into the leftover space; never shorter than the 320px floor, so a
       short viewport pushes the CTA toward the fold rather than letterboxing the
       photo back down. */
    .hero-media {
      flex: 1 1 auto;
      height: auto;
      min-height: 300px;
    }

    /* The card is always measured by its own content — never compressed. */
    .hero-card {
      flex: 0 0 auto;
    }
  }

  /* Below 768px the fixed MobileCTABar (56px button + 1px border-top, see
     MobileCTABar.astro) covers the bottom of the hero, so the first screen is
     that much shorter. */
  @media (max-width: 767.98px) {
    .hero {
      --cta-bar-h: calc(57px + env(safe-area-inset-bottom, 0px));
    }
  }

  /* Short phones (iPhone SE class) cannot carry the 300px band, the full card
     and the CTA pill above the bar at the same time — the card alone is ~432px
     once the headline and the last checklist item wrap. Hand the band's floor
     back so the pill stays tappable without scrolling. 210px, not the previous
     240px: it hands back exactly the 30px the enlarged card takes, so this
     class of phone scrolls no further than it did before. */
  @media (max-width: 767.98px) and (max-height: 700px) {
    .hero-media {
      min-height: 210px;
    }
  }

  /* 768–1023px keeps the 6A stack, but capped and centred. Left full-bleed, an
     820px-wide band would upscale the 600px crop 1.4x into a face-only shot and
     the card would stretch to ~800px with its centred headline adrift. */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .hero-slab {
      max-width: 520px;
      margin: 0 auto;
    }
  }

  /* ── Desktop 9A ──────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .hero {
      /* 8px above the slab; 80px below it — 40px of that is eaten by the trust
         bar's overhang, leaving the same ~40px of clean cream the slab had. */
      padding: calc(var(--header-height) + 8px) 0 80px;
      /* The card's text inset, hoisted to a custom property so the trust bar's
         left edge can align with the headline without repeating the clamp. */
      --hero-inset: clamp(40px, 20.5vw - 170px, 72px);
    }

    .hero-shell {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-lg);
    }

    .hero-slab {
      display: flex;
      align-items: stretch;
      min-height: 520px;
      background: var(--sand);
      border-radius: var(--radius-2xl);
      overflow: hidden;
    }

    /* Photo right, content left, without changing source order. */
    .hero-media {
      order: 2;
      flex: 0 0 51.2%;
      height: auto;
    }

    .hero-media img {
      /* 58% keeps the surgeon centred and pushes the dark door edge to the
         right margin; 50% Y never crops the top of the head. */
      object-position: 58% 50%;
    }

    .hero-card {
      order: 1;
      flex: 1 1 auto;
      /* A percentage flex-basis on a padded column breaks under content-box
         sizing, so the column is auto-basis with an explicit min-width. */
      min-width: 0;
      box-sizing: border-box;
      justify-content: center;
      gap: 0;
      margin: 0;
      /* 72px is the spec'd inset and holds from 1180px up, where .container is
         at its 1180px max. Below that the column loses width faster than the
         copy can give it back: at 1024px a 72px inset leaves 332px of text, the
         H1 spills an extra line and the checklist labels wrap, which pushes the
         slab past 700px and over-crops the portrait. Flexing the inset down to
         40px keeps the H1 at three lines — the comp's own line count — with
         every type size untouched. */
      /* Bottom inset is deeper than the top: the column is
         justify-content:center, so the extra bottom padding lifts the content
         and reserves the strip the trust bar lands on, keeping the CTA note
         ~34px clear of it. */
      padding: 44px var(--hero-inset) 76px;
      background: transparent;
      border-radius: 0;
      box-shadow: none;
    }

    .hero-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      line-height: 1.2;
      color: var(--champagne-dark);
    }

    .hero-headline {
      margin-top: 16px;
      text-align: left;
      /* 42px, not the comp's 46px: the accent line renders at the same size as
         the headline (below), and "with Dr Celal Alioglu" needs 418px at 46px
         against a 396px text column at 1024px, so it would wrap to two lines
         and push the slab ~130px past its 605px design height. 42px measures
         380px and stays on one line at every desktop width. */
      font-size: 42px;
      line-height: 1.1;
      letter-spacing: -0.015em;
    }

    .hl-desktop {
      display: block;
    }

    .hl-mobile {
      display: none;
    }

    /* Desktop pairs the two H1 lines at the same size and weight — the accent
       line reads as the headline's second line, separated only by color. */
    .hl-accent {
      margin-top: 10px;
      line-height: 1.1;
    }

    .hero-features {
      margin-top: 34px;
    }

    .hero-features-desktop {
      display: flex;
    }

    .hero-features-mobile {
      display: none;
    }

    .hero-features li {
      gap: 12px;
      font-size: 15.5px;
    }

    .hero-check {
      width: 22px;
      height: 22px;
    }

    .hero-check::after {
      width: 5px;
      height: 9px;
      border-width: 0 1.75px 1.75px 0;
    }

    .hero-cta {
      margin-top: 26px;
      align-items: flex-start;
    }

    .hero-pill {
      height: 56px;
      width: auto;
      padding: 0 38px;
      font-size: 16px;
    }

    /* ── Trust bar ─────────────────────────────────────────────────── */
    /* White, not ink: the black CTA pill is already the column's one heavy
       block, and a white-on---line tile is the system's existing idiom
       (.hero-check, .surgeon-credential-icon). */
    .hero-trust {
      display: flex;
      align-items: stretch;
      position: relative;
      z-index: 2; /* .hero-card is z-index 1 */
      /* Spans the slab centred, inset by the same amount on both sides as the
         card's text edge — so the bar's left edge still lines up with the
         headline and its right edge mirrors it. */
      width: calc(100% - 2 * var(--hero-inset));
      margin-top: -42px;
      margin-inline: auto;
      padding: 18px 2px;
      background: var(--white);
      border-radius: var(--radius-xl);
      /* Clips each cell's hover tint to the rounded corners. */
      overflow: hidden;
      /* Hairline ring as an inset shadow rather than a border, matching the
         mobile card's idiom — it draws the edge without adding a layout box. */
      box-shadow:
        inset 0 0 0 1px var(--line),
        0 2px 6px rgba(38, 35, 31, 0.05),
        0 16px 40px rgba(38, 35, 31, 0.13);
    }

    .hero-trust-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      /* Equal thirds: the dividers land on exact thirds of the bar regardless
         of how long each platform's label is. */
      flex: 1 1 0;
      min-width: 0;
      padding: 0 26px;
      color: inherit;
      text-decoration: none;
      transition: background var(--transition-fast);
    }

    .hero-trust-item + .hero-trust-item {
      border-left: 1px solid var(--line);
    }

    .hero-trust-item:hover {
      background: var(--cream);
    }

    /* The global a:focus-visible ring sits outside the element, where this
       bar's overflow:hidden would clip it — pull it inside and round it to
       the cell instead of the global --radius-sm. */
    .hero-trust-item:focus-visible {
      outline-offset: -3px;
      border-radius: var(--radius-md);
    }

    /* Fixed height, not min-height: it keeps the two rows on one baseline
       across all three cells even though the lockups differ in aspect. */
    .hero-trust-brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 22px;
    }

    /* Per-brand heights, not one shared value. Equal box heights render very
       unequal type, because each lockup fills its box differently — measured on
       the rendered bar, a single 20px height gave wordmarks of 13.0px
       (Trustpilot, whose box is set by the star), 15.7px (Google) and 20.0px
       (realself, pure ascender height). These three heights even the wordmarks
       up, which is what the eye actually compares.

       width:auto overrides the global `img { height: auto }` reset and keeps
       each derivative's aspect ratio. */
    .hero-trust-logo {
      width: auto;
      height: 20px;
    }

    /* Mark only, paired with the name in text — a solid circular mark reads
       larger than type at the same height, so it steps down. */
    .hero-trust-logo.is-google {
      height: 17px;
    }

    .hero-trust-logo.is-trustpilot {
      height: 23px;
    }

    .hero-trust-logo.is-realself {
      height: 17px;
    }

    .hero-trust-platform {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    .hero-trust-meta {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      line-height: 1.4;
      color: var(--gray-500);
    }

    .hero-trust-star {
      flex: 0 0 auto;
      width: 13px;
      height: 13px;
      color: var(--champagne);
    }

    .hero-trust-score {
      font-weight: 700;
      color: var(--ink);
    }

    .hero-trust-item:hover .hero-trust-platform {
      text-decoration: underline;
    }

    /* Trustpilot's and RealSelf's names live inside their artwork, so those two
       cells have no text to underline — lift the logo instead so every cell
       answers a hover. */
    .hero-trust-item:hover .hero-trust-logo {
      transform: translateY(-1px);
    }

    .hero-trust-logo {
      transition: transform var(--transition-fast);
    }

    /* No token holds this value; it is only ever this separator. */
    .hero-trust-sep {
      color: #c3b8a6;
    }
  }
</style>
