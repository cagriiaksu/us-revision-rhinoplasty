---
import { content } from '../data/content';
const { patientJourney } = content;
const stepIcons = [
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>',
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>',
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v4"/><path d="M14 14h-4"/><path d="M14 18h-4"/><path d="M14 8h-4"/><path d="M18 12h2a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2h2"/><path d="M18 22V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v18"/></svg>',
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>',
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
];
const steps = patientJourney.steps.map((s, i) => ({ ...s, icon: stepIcons[i] }));
---

<section class="journey section" id="journey">
  <div class="container">
    <div class="section-title">
      <span class="eyebrow">{patientJourney.eyebrow}</span>
      <h2>{patientJourney.sectionTitle}</h2>
      <p>{patientJourney.sectionSubtitle}</p>
    </div>

    <div class="journey-timeline">
      {steps.map((step, i) => (
        <div class="journey-step">
          <div class="journey-step-marker">
            <div class="journey-step-number" set:html={step.icon}></div>
            {i < steps.length - 1 && <div class="journey-step-connector"></div>}
          </div>
          <div class="journey-step-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="journey-cta">
      <a href="#consultation" class="btn btn-primary btn-lg" data-open-form-modal>{patientJourney.ctaButton}</a>
    </div>
  </div>
</section>

<style>
  .journey {
    background: var(--white);
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }

  /* --- Mobile: Vertical Timeline --- */
  .journey-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: var(--space-2xl);
  }

  .journey-step {
    display: flex;
    gap: var(--space-lg);
  }

  .journey-step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .journey-step-number {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--cream);
    font-weight: 700;
    font-size: 1rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .journey-step-connector {
    width: 1px;
    flex: 1;
    min-height: 24px;
    background: var(--champagne-soft);
  }

  .journey-step-content {
    padding-bottom: var(--space-xl);
  }

  .journey-step-content h3 {
    font-size: 1.125rem;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .journey-step-content p {
    font-size: 0.9375rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  .journey-cta {
    text-align: center;
  }

  /* --- Desktop: Horizontal Timeline --- */
  @media (min-width: 768px) {
    .journey-timeline {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: auto 1fr;
      gap: 0;
      position: relative;
      margin-left: calc(-1 * var(--space-2xl));
      margin-right: calc(-1 * var(--space-2xl));
    }

    .journey-timeline::before {
      content: '';
      position: absolute;
      top: 24px;
      left: calc(100% / 12);
      right: calc(100% / 12);
      height: 1px;
      background: var(--champagne-soft);
      z-index: 0;
    }

    .journey-step {
      display: contents;
    }

    .journey-step-marker {
      grid-row: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    .journey-step-number {
      flex-shrink: 0;
    }

    .journey-step-connector {
      display: none;
    }

    .journey-step-content {
      grid-row: 2;
      padding: var(--space-md) var(--space-sm) 0;
      text-align: center;
    }

    .journey-step-content h3 {
      font-size: 1rem;
    }

    .journey-step-content p {
      font-size: 0.8125rem;
    }
  }

  @media (min-width: 1024px) {
    .journey-step-content h3 {
      font-size: 1.125rem;
    }

    .journey-step-content p {
      font-size: 0.875rem;
    }
  }
</style>
