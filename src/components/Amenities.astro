---
import { content } from '../data/content';
const { amenities } = content;
---

<section class="amenities section">
  <div class="container">
    <div class="section-title">
      <span class="eyebrow">{amenities.eyebrow}</span>
      <h2>{amenities.sectionTitle}</h2>
      <p>{amenities.sectionSubtitle}</p>
    </div>

    <div class="amenities-grid">
      {amenities.items.map(item => (
        <article class="amenity-card">
          <div class="amenity-image">
            <img src={item.image} alt={item.alt} width="450" height="340" loading="lazy" decoding="async" />
          </div>
          <h3 class="amenity-title">{item.title}</h3>
          <p class="amenity-desc">{item.description}</p>
        </article>
      ))}
    </div>

    <div class="amenities-cta">
      <a href="#consultation" class="btn btn-primary btn-lg" data-open-form-modal>{amenities.ctaButton}</a>
    </div>
  </div>
</section>

<style>
  .amenities {
    background: var(--cream);
    content-visibility: auto;
    contain-intrinsic-size: auto 700px;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .amenity-card {
    background: var(--white);
    border: 1px solid var(--line);
    text-align: left;
    padding: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .amenity-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .amenity-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    display: block;
  }

  .amenity-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .amenity-title {
    color: var(--ink);
    font-size: 1.1875rem;
    font-weight: 500;
    margin-bottom: var(--space-sm);
    padding: var(--space-lg) var(--space-lg) 0;
  }

  .amenity-desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 0 var(--space-lg) var(--space-xl);
  }

  .amenities-cta {
    text-align: center;
  }

  @media (min-width: 768px) {
    .amenities-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .amenities-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
