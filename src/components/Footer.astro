---
import { content } from '../data/content';
const { footer } = content;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="#hero" class="footer-logo" aria-label="Dr. Celal Alioglu">
          <span class="footer-logo-wordmark">Dr. Celal Alioglu</span>
        </a>
        <p class="footer-tagline">{footer.tagline}</p>
      </div>

      <div class="footer-contact">
        <h4>{footer.contactTitle}</h4>
        <ul class="footer-contact-list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <a href={footer.contact.addressLink} target="_blank" rel="noopener noreferrer">{footer.contact.address}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <a href={footer.contact.phoneLink}>{footer.contact.phone}</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 6L2 7" />
            </svg>
            <a href={footer.contact.emailLink}>{footer.contact.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{footer.copyright.replace('{year}', String(currentYear))}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    padding: var(--space-3xl) 0 var(--space-lg);
    content-visibility: auto;
    contain-intrinsic-size: auto 300px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-md);
  }

  .footer-logo-wordmark {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 0.01em;
  }

  .footer-tagline {
    color: rgba(250, 247, 242, 0.6);
    font-size: 0.9375rem;
    max-width: 360px;
  }

  .footer-contact h4 {
    color: var(--cream);
    font-size: 1.0625rem;
    margin-bottom: var(--space-sm);
    font-family: var(--font-heading);
    font-weight: 500;
  }

  .footer-contact-list {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 360px;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .footer-contact-list svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--champagne);
  }

  .footer-contact-list a {
    color: rgba(250, 247, 242, 0.7);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-contact-list a:hover {
    color: var(--cream);
  }

  .footer-bottom {
    border-top: 1px solid rgba(250, 247, 242, 0.1);
    padding-top: var(--space-lg);
    text-align: center;
  }

  .footer-bottom p {
    color: rgba(250, 247, 242, 0.45);
    font-size: 0.8125rem;
  }

  @media (max-width: 767px) {
    .footer {
      padding-bottom: 96px;
    }
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr;
      align-items: start;
    }
  }
</style>
