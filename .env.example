# Make.com webhook URL for the UK facial-surgery consultation form.
# Required in production: if this is unset the form logs the payload to the
# console and shows the success state without sending the lead anywhere.
# PUBLIC_ vars are baked in at build time, so .env must exist on the machine
# that runs `npm run build` — .env is gitignored and never reaches the repo.
PUBLIC_MAKE_WEBHOOK_URL=https://hook.eu2.make.com/YOUR_WEBHOOK_ID_HERE

# PostHog is not used on this landing page (GTM is hardcoded in Layout.astro).
# PUBLIC_POSTHOG_KEY=phc_YOUR_KEY_HERE
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
